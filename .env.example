PORT=4000
STAGE=Dev
LOG_LEVEL=development
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost:8081

# MongoDB Atlas
DB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/edu-tracker?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (optional)
ADMIN_EMAIL=admin@edutracker.com
ADMIN_PASSWORD=Admin@123456
